# Social graph + gamification (slice social-social): SocialController and
# GamificationController, 32 routes.
#
# The write cases are not idempotent (accept, decline, block, redeem...), so
# Vapor and v2 each run against their OWN copy of the scratch database, seeded
# identically. One-time setup (scratch Postgres on :55499 only):
#
#   docker exec norviq-v2-schema-pg sh -c 'pg_dump -U pg -d norviq --no-owner -Fc -f /tmp/n.dump &&
#     for d in parity_social_a parity_social_b; do createdb -U pg $d && pg_restore -U pg -d $d --no-owner /tmp/n.dump; done; rm /tmp/n.dump'
#
# Before every pass (re-seed both):
#
#   for d in parity_social_a parity_social_b; do psql postgres://pg:pg@127.0.0.1:55499/$d -q -f parity/social-setup.sql; done
#
# Servers, both with the flagged-Vapor flags
#   FLAGS='SOCIAL_ENABLED=1 SOCIAL_ACTIVITY_FEED_ENABLED=1 ACHIEVEMENTS_ENABLED=1 ARTICLES_ENABLED=1 SOCIAL_CONTACT_PEPPER=parity-pepper
#          SOCIAL_FACEBOOK_IMPORT_ENABLED=1 FACEBOOK_APP_ID=parity-fb-app NORVIQ_ADMIN_USER_IDS=0A11CE00-0000-4000-8000-000000000001'
#   Vapor: env DATABASE_HOST=127.0.0.1 DATABASE_PORT=55499 DATABASE_USERNAME=pg DATABASE_PASSWORD=pg DATABASE_NAME=parity_social_a
#          JWT_SECRET=parity-secret $FLAGS "$(cd ../.norviq-backend-snapshot && swift build --show-bin-path)/StockPlanBackend" serve --port 18142
#   v2:    set -a; . ./.env.example; set +a; env PORT=18141 DATABASE_NAME=parity_social_b LEGACY_UPSTREAM_URL=http://127.0.0.1:8081
#          JWT_SECRET=parity-secret $FLAGS go run ./cmd/api serve
#
# Run (cases are ordered; a pass needs a fresh seed):
#
#   go run ./cmd/parity -a http://127.0.0.1:18142 -b http://127.0.0.1:18141 -jwt-secret parity-secret -cases parity/social.jsonl
#
# Random values (new invite codes, new request ids) are in social-random.jsonl.
# Flag-off behaviour (everything 404s except /config) is social-off.jsonl,
# against the unflagged Vapor on :8081 and a v2 with no social flags.
