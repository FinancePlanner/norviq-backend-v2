# Banking + Telegram integrations. Seed parity/banking-setup.sql, then:
#   go run ./cmd/parity -a http://127.0.0.1:8081 -b http://127.0.0.1:18116 -jwt-secret parity-secret \
#     -headers Content-Type,Location -cases parity/banking.jsonl
