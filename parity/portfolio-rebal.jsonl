#     -cases parity/portfolio-rebal.jsonl -headers Content-Type,Content-Disposition \
#     -ignore requestId,id,createdAt,updatedAt,completedAt,cancelledAt,generatedAt,pricedAt,simulationId
# The simulation cases sit behind a 30 per 60 s rate limit keyed by IP; keep
# them at 13 or fewer and wait a minute between runs.
