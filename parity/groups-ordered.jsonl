{"name": "after-detail-g1", "path": "/v1/groups/9a0e0000-0000-4000-8000-000000000101", "as": "9a0e0000-0000-4000-8000-000000000001"}
{"name": "after-members-g1", "path": "/v1/groups/9a0e0000-0000-4000-8000-000000000101/members", "as": "9a0e0000-0000-4000-8000-000000000001"}
{"name": "after-bans-g1", "path": "/v1/groups/9a0e0000-0000-4000-8000-000000000101/bans", "as": "9a0e0000-0000-4000-8000-000000000001"}
