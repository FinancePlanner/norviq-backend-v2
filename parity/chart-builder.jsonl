{"name":"too many compare","method":"GET","path":"/v1/market/chart-builder/AAPL?metrics=revenue&compare=a,b,c,d","as":"ae005000-0000-4000-8000-000000000003"}
{"name":"compare drops primary","method":"GET","path":"/v1/market/chart-builder/aapl?metrics=revenue&compare=AAPL,msft","as":"ae005000-0000-4000-8000-000000000003"}
