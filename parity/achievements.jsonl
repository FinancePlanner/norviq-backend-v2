# Achievements + social feed (AchievementController, SocialFeedController).
# Seed first (resets the slice's rows, re-run before every run):
#   psql "postgres://pg:pg@127.0.0.1:55499/norviq" -f parity/achievements-setup.sql
# Both backends need SOCIAL_ENABLED=1 SOCIAL_ACTIVITY_FEED_ENABLED=1
# ACHIEVEMENTS_ENABLED=1 (the flagged Vapor on :18124), then:
#   go run ./cmd/parity -a http://127.0.0.1:18124 -b http://127.0.0.1:18149 -jwt-secret parity-secret \
#     -cases parity/achievements.jsonl
# Flag-off 404s are parity/achievements-flagoff.jsonl (Vapor :8081, v2 without the flags).
# Writes run on A first, then B on the same rows: seen, showcase and congrats
# are idempotent, so both answer the same.
