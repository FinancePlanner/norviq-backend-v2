# Phase one of the expenses-import parity pass (see parity/expenses-import-setup.sql).
# POST /v1/expenses/import/spreadsheet. Run with -ignore requestId,sessionId,expiresAt.
# Only upload-ok (user 1) and upload-multipart-ok (user 4) create sessions.
{"name": "upload-unauth", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "headers": {"Content-Type": "application/octet-stream"}, "bodyFile": "parity/expenses-import/excel-like.xlsx"}
{"name": "upload-read-scope", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "headers": {"Content-Type": "application/octet-stream", "Authorization": "Bearer nvq_pat_parityexpimportread"}, "bodyFile": "parity/expenses-import/excel-like.xlsx"}
{"name": "upload-pat-not-first-party", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "headers": {"Content-Type": "application/octet-stream", "Authorization": "Bearer nvq_pat_parityexpimportwrite"}, "bodyFile": "parity/expenses-import/excel-like.xlsx"}
{"name": "upload-free", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000002", "headers": {"Content-Type": "application/octet-stream"}, "bodyFile": "parity/expenses-import/excel-like.xlsx"}
{"name": "upload-empty", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "application/octet-stream"}}
{"name": "upload-garbage", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "application/octet-stream"}, "bodyFile": "parity/expenses-import/garbage.bin"}
{"name": "upload-legacy-xls", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "application/octet-stream"}, "bodyFile": "parity/expenses-import/legacy.xls"}
{"name": "upload-multipart-no-file", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "multipart/form-data; boundary=PARITYB"}, "bodyFile": "parity/expenses-import/sheet-no-file.bin"}
{"name": "upload-multipart-no-filename", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "multipart/form-data; boundary=PARITYB"}, "bodyFile": "parity/expenses-import/sheet-file-no-filename.bin"}
{"name": "upload-multipart-empty-form", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "multipart/form-data; boundary=PARITYB"}, "bodyFile": "parity/expenses-import/empty-form.bin"}
{"name": "upload-multipart-no-boundary", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "multipart/form-data"}, "bodyFile": "parity/expenses-import/sheet-no-file.bin"}
{"name": "upload-ok", "method": "POST", "path": "/v1/expenses/import/spreadsheet", "as": "e5e00000-0000-4000-8000-000000000001", "headers": {"Content-Type": "application/octet-stream", "X-File-Name": "excel-like.xlsx"}, "bodyFile": "parity/expenses-import/excel-like.xlsx"}
