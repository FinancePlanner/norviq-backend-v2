# The web's public token path: ARTICLES_VIEWER_CREDENTIAL_IDS lists the
# parity-web PAT (a2710000-...-e1). Seed parity/articles-setup.sql first, then run a
# Vapor on 18146 and v2 on 18145, both with the brief's flags plus
#   ARTICLES_VIEWER_CREDENTIAL_IDS=A2710000-0000-4000-8000-0000000000E1
# go run ./cmd/parity -a http://127.0.0.1:18146 -b http://127.0.0.1:18145 -jwt-secret parity-secret \
#   -cases parity/articles-viewer.jsonl -headers Content-Type,X-Content-Type-Options,Cache-Control
{"name": "web-view-alice", "method": "POST", "path": "/v1/articles/pzbbbbbb/view", "headers": {"Authorization": "Bearer nvq_pat_parityarticlesweb000000000001", "X-Norviq-Viewer": "0123456789abcdef0123456789abcdef"}}
