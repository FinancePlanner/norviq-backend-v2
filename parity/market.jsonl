# routes share a 100/min per-IP limiter, so wait a minute between runs.
#   go run ./cmd/parity -a http://127.0.0.1:8081 -b http://127.0.0.1:18103 -jwt-secret parity-secret \
#     -cases parity/market.jsonl -ignore requestId
