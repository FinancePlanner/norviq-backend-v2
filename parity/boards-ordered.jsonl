# Order-dependent boards cases: the first backend to run creates, toggles or
# deletes, so the second sees the next state. Run twice, once per order,
# resetting the fixtures before each run:
#   docker exec -i norviq-v2-schema-pg psql -U pg -d norviq < parity/boards-setup.sql
#   go run ./cmd/parity -a http://127.0.0.1:8081 -b http://127.0.0.1:18143 -jwt-secret parity-secret -cases parity/boards-ordered.jsonl -ignore requestId,id,createdAt
#   (reset again)
#   go run ./cmd/parity -a http://127.0.0.1:18143 -b http://127.0.0.1:8081 -jwt-secret parity-secret -cases parity/boards-ordered.jsonl -ignore requestId,id,createdAt
# Expected, in both orders, the same diffs: whichever backend runs first gets
#   create-board 200 / 409, vote-on {score:2,voted:true} / {score:1,voted:false},
#   vote-again the reverse, delete-post 204 / 404, delete-comment 204 / 404,
#   board-cap: carol's 3rd board 200 / 429 board_limit_reached;
# and the follow-up reads (board-after, posts-after) match exactly.
{"name":"create-board","method":"POST","path":"/v1/boards","as":"b0a4d000-0000-4000-8000-000000000002","body":{"slug":" Parity-New ","name":"  Parity   new ","description":" Fresh "}}
